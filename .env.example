# Copy this file to ".env" and put your real keys there.
# ".env" is listed in .gitignore, so it never goes to GitHub.
# Never paste real keys into this example file.

OPENAQ_API_KEY=put-your-openaq-key-here
FIRMS_MAP_KEY=put-your-nasa-firms-key-here
HF_TOKEN=put-your-hugging-face-write-token-here
GROQ_API_KEY=put-your-groq-key-here
GEMINI_API_KEY=put-your-google-ai-studio-key-here
# Address of the hosted Insight Agent (from Render), used by `python -m smog deploy-space` for the Ask tab
AGENT_URL=https://smog-insight-agent.onrender.com
